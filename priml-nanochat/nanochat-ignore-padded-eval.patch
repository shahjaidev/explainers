+def test_a_padded_eval_batch_scores_as_its_unpadded_self() -> None:
+    """A squared-off final eval batch must not reach the loss as data.
+
+    The loader pads a short final batch to full width and marks the padding
+    with ``-1`` targets, which is not a class index -- passing it to
+    ``cross_entropy`` raises. Scoring the same row twice, once padded and once
+    not, pins both halves of the contract: the padded call runs, and the number
+    it reports is the unpadded one rather than a mean diluted by rows that are
+    not data.
+    """
+    full = _batch()
+    one_row = {"media": full["media"][:1], "label": full["label"][:1]}
+    padded = {
+        "media": full["media"],
+        "label": torch.cat([full["label"][:1], torch.full((1, SEQ), -1)]),
+        "valid_count": 1,
+    }
+
+    step = _step()
+    expected = step.eval_loss(**one_row)
+    actual = step.eval_loss(**padded)
+
+    assert torch.equal(actual["loss"], expected["loss"])
+    # Full width, because the metric pairs this tensor with the batch's own
+    # targets and rejects a shape that disagrees.
+    assert actual["model"].shape == (2, SEQ)
+    assert torch.equal(actual["model"][:1], expected["model"])
+
